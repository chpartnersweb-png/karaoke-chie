---
import { getImage } from 'astro:assets';
import exterior from '../assets/S__5783565.jpg';
import { site } from '../data/site';
import { seo, absoluteUrl, createStructuredData } from '../lib/seo';

// Use a real venue photograph for sharing and business identification.
const shareImage = await getImage({
  src: exterior,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
  quality: 88,
});
const imageUrl = absoluteUrl(shareImage.src);
const structuredData = JSON.stringify(createStructuredData({
  url: imageUrl,
  width: 1200,
  height: 630,
})).replace(/</g, '\\u003c');
---
<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<link rel="canonical" href={seo.canonical} />
<meta property="og:type" content="website" />
<meta property="og:locale" content="ja_JP" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:url" content={seo.canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:secure_url" content={imageUrl} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={seo.imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={seo.imageAlt} />
<script type="application/ld+json" set:html={structuredData} />
