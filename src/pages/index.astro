---
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import { site, mapUrl, dishes, flyerRates, yen } from '../data/site';
import hero from '../assets/hero-chie-concept.png';
import stage from '../assets/S__5783566.jpg';
import seats from '../assets/S__5783567.jpg';
import curry from '../assets/S__5783563.jpg';
import flyer from '../assets/S__5783570.jpg';
import entrance from '../assets/S__5783565.jpg';
import '../styles/global.css';

const description = `小倉・京町の${site.name}。歌う時間も、食事の時間も。${site.station}。店内の雰囲気、お食事、ご利用案内、アクセスをご紹介します。ご予約・お問い合わせは${site.phone}へ。`;
const links = [
  { href: '#about', label: 'チエのこと' },
  { href: '#menu', label: 'お食事' },
  { href: '#guide', label: 'ご利用案内' },
  { href: '#access', label: 'アクセス' },
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#291b2d" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content="カラオケ喫茶チエ｜歌って、笑って、ひと息。小倉・京町" />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <link rel="icon" type="image/svg+xml" href="/chie-mark.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600&family=Noto+Serif+JP:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>カラオケ喫茶チエ｜歌って、笑って、ひと息。小倉・京町</title>
  </head>
  <body>
    <a href="#main" class="skip-link">本文へ移動</a>
    <header class="site-header" data-header>
      <a class="header-brand" href="#home" aria-label="カラオケ喫茶チエ トップへ"><Icon name="mic" size={21} /><span><small>カラオケ喫茶</small><strong>チエ</strong></span></a>
      <nav class="desktop-nav" aria-label="メインナビゲーション">{links.map(link => <a href={link.href}>{link.label}</a>)}</nav>
      <a class="header-phone" href={site.phoneHref}><Icon name="phone" size={17} /><span>{site.phone}</span></a>
      <details class="mobile-nav" data-mobile-nav>
        <summary><span class="menu-lines" aria-hidden="true"></span><span class="sr-only">メニューを開閉</span></summary>
        <nav aria-label="モバイルナビゲーション">
          {links.map((link, i) => <a href={link.href}><small>0{i + 1}</small>{link.label}<Icon name="arrow" size={20} /></a>)}
          <a class="mobile-nav-phone" href={site.phoneHref}><Icon name="phone" size={18} />{site.phone}</a>
        </nav>
      </details>
    </header>

    <main id="main">
      <section id="home" class="hero" aria-labelledby="hero-title">
        <div class="hero-image" data-hero-image><Image src={hero} alt="" widths={[640, 960, 1440, 1920]} sizes="100vw" format="webp" quality={86} loading="eager" fetchpriority="high" /></div>
        <div class="hero-shade"></div>
        <div class="hero-title-wrap">
          <p class="hero-location" data-hero-reveal>KOKURA, KYOMACHI</p>
          <h1 id="hero-title" class="hero-title" aria-label={site.name}><span class="hero-karaoke" data-hero-reveal>カラオケ喫茶</span><span class="hero-chie" data-hero-reveal>チエ</span></h1>
          <p class="hero-copy" data-hero-reveal>歌って、笑って、ひと息。</p>
        </div>
        <a class="hero-scroll" href="#about"><span>SCROLL TO DISCOVER</span><span class="scroll-line" aria-hidden="true"></span></a>
        <span class="hero-side-note" aria-hidden="true">A SONG, A SMILE, A LITTLE BREAK.</span>
      </section>

      <div class="quick-info" aria-label="営業情報"><p><Icon name="pin" size={16} />{site.station}</p><span class="info-divider" aria-hidden="true"></span><p><span class="small-dot" aria-hidden="true"></span>13:00 OPEN</p><span class="info-divider" aria-hidden="true"></span><p>月曜日定休</p></div>

      <section id="about" class="about section-space" aria-labelledby="about-title">
        <div class="about-heading page-gutter" data-reveal><p class="eyebrow"><span>01</span> ABOUT CHIE</p><h2 id="about-title">歌が灯る、<br /><span>小倉の喫茶。</span></h2><span class="heading-ornament" aria-hidden="true">♪</span></div>
        <figure class="stage-photo photo-reveal" data-photo>
          <div class="photo-inner" data-parallax><Image src={stage} alt="青紫の照明に縁どられたステージと白いソファのあるチエの店内" widths={[640, 1000, 1430]} sizes="(max-width: 700px) 94vw, 82vw" format="webp" loading="lazy" /></div>
          <figcaption><span>THE STAGE</span><span>いつもの一曲が、今日の楽しみに。</span></figcaption>
        </figure>
        <div class="about-story page-gutter">
          <p class="vertical-note" aria-hidden="true">ひと息ついて、もう一曲。</p>
          <div class="story-copy" data-reveal><p class="eyebrow">SING. EAT. RELAX.</p><h3>マイクを持つ時間も、<br />テーブルを囲む時間も。</h3><p>小倉・京町のカラオケ喫茶チエ。<br />ステージで好きな歌を歌ったり、<br class="desktop-break" />席に戻って食事を楽しんだり。</p><p>歌う時間と、くつろぐ時間。<br />その両方を、どうぞチエで。</p><a class="text-link" href="#guide">ご利用案内を見る<Icon name="arrow" size={23} /></a></div>
        </div>
        <div class="seats-row">
          <figure class="seats-photo photo-reveal" data-photo><div class="photo-inner"><Image src={seats} alt="木のテーブルを囲む白いソファと、店内奥のカウンター" widths={[600, 900, 1200]} sizes="(max-width: 700px) 90vw, 58vw" format="webp" loading="lazy" /></div><figcaption><span>TAKE A SEAT</span><span>歌の合間に、ゆっくりと。</span></figcaption></figure>
          <div class="seat-detail" data-reveal><span class="eyebrow">SPACE</span><p>お席は<br /><strong>30<span>〜</span>40</strong><span>人</span></p><span class="seat-rule" aria-hidden="true"></span><p class="seat-caption">ご来店人数などのご相談は<br />お電話でお問い合わせください。</p></div>
        </div>
      </section>

      <section id="menu" class="food section-space" aria-labelledby="menu-title">
        <div class="food-heading" data-reveal><p class="eyebrow"><span>02</span> THE CAFE MENU</p><h2 id="menu-title">歌の合間の、<br class="mobile-break" />おいしい時間。</h2><p>おなかが空いたら、ひと休み。<br />お食事も、おつまみも。</p></div>
        <figure class="curry-photo photo-reveal" data-photo><Image src={curry} alt="白いお皿に盛り付けたチエのカレーライス" widths={[480, 800, 1100]} sizes="(max-width: 700px) 86vw, 60vw" format="webp" loading="lazy" /><figcaption><span>CHIE'S CURRY RICE</span><span>カレー</span></figcaption></figure>
        <div class="menu-sheet"><div class="menu-sheet-heading" data-reveal><h3>チエの人気メニュー</h3><span>FAVORITES</span></div><ol class="dish-list">{dishes.map((dish, index) => <li data-menu-row><span class="dish-number">0{index + 1}</span><span class="dish-name">{dish.name}</span><span class="dish-english">{dish.english}</span>{dish.price !== null && <span class="dish-price">{yen(dish.price)}</span>}</li>)}</ol><p class="menu-footnote">お食事の価格は、お店へお問い合わせください。</p></div>
        <span class="food-watermark" aria-hidden="true">Bon appétit.</span>
      </section>

      <section id="guide" class="guide section-space" aria-labelledby="guide-title">
        <div class="guide-heading page-gutter" data-reveal><p class="eyebrow"><span>03</span> GOOD TIMES AT CHIE</p><h2 id="guide-title">さあ、もう一曲。</h2><p>チエで過ごす時間の、ご案内。</p></div>
        <div class="guide-content">
          <div class="rate-panel" data-reveal>
            <div class="rate-title"><h3>セット料金</h3><span>SET MENU</span></div><p class="rate-source">ご案内チラシ記載の料金</p>
            <table class="rate-table"><caption class="sr-only">ご案内チラシに記載された昼・夜のセット料金</caption><thead><tr><th scope="col"><span class="sr-only">セット</span></th><th scope="col">女性</th><th scope="col">男性</th></tr></thead><tbody>{flyerRates.map(rate => <tr><th scope="row">{rate.label}<small>{rate.english}</small></th><td>{yen(rate.women)}</td><td>{yen(rate.men)}</td></tr>)}</tbody></table>
            <div class="set-includes"><span>セット内容</span><p>カラオケ歌い放題<br />ワンドリンク・フルーツチャーム付き</p></div>
            <p class="rate-note">チラシでは、アルコールへの変更は＋200円でご案内しています。<br />最新の料金・セット内容はお電話でお問い合わせください。</p>
            <a class="text-link light-link" href={site.phoneHref}>電話で問い合わせる<Icon name="arrow" size={22} /></a>
          </div>
          <div class="flyer-panel" data-reveal><a class="flyer-link" href={flyer.src} target="_blank" rel="noopener noreferrer" data-flyer-open aria-haspopup="dialog" aria-controls="flyer-dialog"><Image src={flyer} alt="カラオケ喫茶チエの料金・セット内容・飲み放題などが記載されたご案内チラシ" widths={[420, 700, 1100]} sizes="(max-width: 900px) 85vw, 34vw" format="webp" loading="lazy" /><span class="flyer-open-label">ご案内チラシを拡大する<span aria-hidden="true">＋</span></span></a><p class="flyer-note">チラシと現在のご案内が異なる場合がございます。<br />営業時間・アクセスは下記の店舗情報をご覧ください。</p></div>
        </div>
        <div class="guide-bottom page-gutter"><Icon name="mic" size={20} /><p>歌う日も、食事を楽しむ日も。<br class="mobile-break" />ご来店をお待ちしています。</p></div>
      </section>

      <section id="access" class="access section-space" aria-labelledby="access-title">
        <div class="access-heading page-gutter" data-reveal><p class="eyebrow"><span>04</span> FIND US IN KOKURA</p><h2 id="access-title">紫の看板が、<br />目印です。</h2><a href={mapUrl} target="_blank" rel="noopener noreferrer" class="text-link">Googleマップで見る<Icon name="arrow" size={23} /></a></div>
        <figure class="entrance-photo photo-reveal" data-photo><Image src={entrance} alt="カラオケ チエの紫色の看板と店舗入口" widths={[640, 1000, 1477]} sizes="(max-width: 700px) 94vw, 80vw" format="webp" loading="lazy" /><figcaption><span>WELCOME TO CHIE</span><span>小倉・京町で、お待ちしています。</span></figcaption></figure>
        <div class="shop-details" data-reveal>
          <div class="shop-sign"><Icon name="mic" size={29} /><p>カラオケ喫茶<span>チエ</span></p><span class="shop-sign-en">KARAOKE & CAFE</span></div>
          <dl class="shop-info">
            <div><dt>住所</dt><dd><span class="address-text">{site.address}</span><a href={mapUrl} target="_blank" rel="noopener noreferrer" class="map-inline">MAP <Icon name="arrow" size={16} /></a></dd></div>
            <div><dt>アクセス</dt><dd>{site.station}</dd></div>
            <div><dt>営業時間</dt><dd><span class="hours-line"><span>平日</span><span>{site.weekdayHours}</span></span><span class="hours-line"><span>土日祝</span><span>{site.weekendHours}</span></span></dd></div>
            <div><dt>定休日</dt><dd>{site.closed}</dd></div>
            <div><dt>お席</dt><dd>{site.capacity}</dd></div>
            <div><dt>電話番号</dt><dd><a href={site.phoneHref} class="info-phone">{site.phone}</a></dd></div>
            <div><dt>SNS</dt><dd><a class="instagram-link" href={site.instagram} target="_blank" rel="noopener noreferrer"><Icon name="instagram" size={20} /><span>Instagram</span><Icon name="arrow" size={18} /></a></dd></div>
          </dl>
        </div>
      </section>

      <section id="contact" class="contact" aria-labelledby="contact-title"><div data-reveal><p class="eyebrow">LET'S HAVE A GOOD TIME</p><h2 id="contact-title">次の一曲は、チエで。</h2><p class="contact-label">ご予約・お問い合わせ</p><a class="contact-phone" href={site.phoneHref}><Icon name="phone" size={30} /><span>{site.phone}</span></a><p class="contact-hours">平日 {site.weekdayHours}<span>／</span>土日祝 {site.weekendHours}<br class="mobile-break" /><span class="contact-closed">月曜日定休</span></p></div></section>
    </main>

    <footer class="site-footer"><a class="footer-name" href="#home">カラオケ喫茶チエ</a><small>© {new Date().getFullYear()} カラオケ喫茶チエ</small><a class="back-top" href="#home">PAGE TOP <span aria-hidden="true">↑</span></a></footer>
    <nav class="mobile-actions" aria-label="お電話とアクセス"><a href={site.phoneHref}><Icon name="phone" size={19} /><span>電話する</span></a><a href={mapUrl} target="_blank" rel="noopener noreferrer"><Icon name="pin" size={20} /><span>地図を見る</span></a></nav>
    <dialog id="flyer-dialog" class="flyer-dialog" aria-labelledby="flyer-dialog-title" data-lenis-prevent><div class="dialog-toolbar"><h2 id="flyer-dialog-title">ご利用案内</h2><form method="dialog"><button type="submit" class="dialog-close" aria-label="チラシを閉じる"><Icon name="close" size={24} /></button></form></div><p class="dialog-note">チラシ記載の内容です。最新の料金・プランはお電話でお問い合わせください。</p><img src={flyer.src} width={flyer.width} height={flyer.height} alt="カラオケ喫茶チエのご案内チラシ全体" loading="lazy" /></dialog>
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
